<Window x:Class="StudentAttendanceApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Student Attendance"
        Height="700"
        Width="1150"
        MinHeight="620"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Label di atas input -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- Gaya seragam untuk TextBox, ComboBox, DatePicker -->
        <Style x:Key="InputStyle" TargetType="Control">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Gaya tombol aksi -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="25"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= JUDUL ================= -->
        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,20">
            <TextBlock Text="STUDENT ATTENDANCE"
                       FontSize="28"
                       FontWeight="Bold"/>
            <TextBlock Text="Aplikasi pencatatan absensi mahasiswa"
                       Foreground="#666666"/>
        </StackPanel>

        <!-- ================= FORM ABSENSI ================= -->
        <Border Grid.Row="1" Grid.Column="0"
                BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="6" Padding="18">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="FORM ABSENSI" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

                    <TextBlock Text="NIM" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="txtNim" Style="{StaticResource InputStyle}" MaxLength="12"/>

                    <TextBlock Text="Nama Mahasiswa" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="txtNama" Style="{StaticResource InputStyle}" MaxLength="60"/>

                    <TextBlock Text="Mata Kuliah" Style="{StaticResource LabelStyle}"/>
                    <ComboBox x:Name="cmbMatkul" Style="{StaticResource InputStyle}"/>

                    <TextBlock Text="Tanggal" Style="{StaticResource LabelStyle}"/>
                    <DatePicker x:Name="dpTanggal" Style="{StaticResource InputStyle}"/>

                    <TextBlock Text="Status Kehadiran" Style="{StaticResource LabelStyle}"/>
                    <WrapPanel Margin="0,0,0,12">
                        <RadioButton x:Name="rbHadir" Content="Hadir" Tag="Hadir"
                                     GroupName="StatusGroup" IsChecked="True" Margin="0,0,15,0"/>
                        <RadioButton x:Name="rbIzin" Content="Izin" Tag="Izin"
                                     GroupName="StatusGroup" Margin="0,0,15,0"/>
                        <RadioButton x:Name="rbSakit" Content="Sakit" Tag="Sakit"
                                     GroupName="StatusGroup" Margin="0,0,15,0"/>
                        <RadioButton x:Name="rbAlpha" Content="Alpha" Tag="Alpha"
                                     GroupName="StatusGroup"/>
                    </WrapPanel>

                    <TextBlock Text="Keterangan (wajib jika Izin / Sakit)" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="txtKeterangan"
                             Height="60"
                             Margin="0,0,0,15"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             MaxLength="150"/>

                    <UniformGrid Columns="2">
                        <Button x:Name="btnSimpan" Content="Simpan"
                                Style="{StaticResource ActionButtonStyle}"
                                Click="BtnSimpan_Click"/>
                        <Button x:Name="btnUpdate" Content="Update"
                                Style="{StaticResource ActionButtonStyle}"
                                IsEnabled="False"
                                Click="BtnUpdate_Click"/>
                        <Button x:Name="btnReset" Content="Reset"
                                Style="{StaticResource ActionButtonStyle}"
                                Click="BtnReset_Click"/>
                        <Button x:Name="btnHapus" Content="Hapus"
                                Style="{StaticResource ActionButtonStyle}"
                                IsEnabled="False"
                                Click="BtnHapus_Click"/>
                    </UniformGrid>

                    <TextBlock Text="Tip: klik satu baris di tabel untuk mengedit atau menghapus data."
                               Foreground="#888888" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ================= DATA ABSENSI ================= -->
        <Grid Grid.Row="1" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Pencarian dan filter -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Cari (NIM / Nama / Mata Kuliah)" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="txtSearch"
                             Style="{StaticResource InputStyle}"
                             Margin="0"
                             TextChanged="TxtSearch_TextChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Filter Status" Style="{StaticResource LabelStyle}"/>
                    <ComboBox x:Name="cmbFilterStatus"
                              Style="{StaticResource InputStyle}"
                              Margin="0"
                              SelectedIndex="0"
                              SelectionChanged="CmbFilterStatus_SelectionChanged">
                        <ComboBoxItem Content="Semua Status"/>
                        <ComboBoxItem Content="Hadir"/>
                        <ComboBoxItem Content="Izin"/>
                        <ComboBoxItem Content="Sakit"/>
                        <ComboBoxItem Content="Alpha"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <!-- Tabel data -->
            <DataGrid x:Name="dgAttendance"
                      Grid.Row="1"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      AlternatingRowBackground="#F7F7F7"
                      RowHeight="30"
                      SelectionChanged="DgAttendance_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="NIM" Binding="{Binding Nim}" Width="105"/>
                    <DataGridTextColumn Header="Nama" Binding="{Binding Nama}" Width="1.2*"/>
                    <DataGridTextColumn Header="Mata Kuliah" Binding="{Binding MataKuliah}" Width="1.2*"/>
                    <DataGridTextColumn Header="Tanggal" Binding="{Binding TanggalText}" Width="90"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="70">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Hadir">
                                        <Setter Property="Foreground" Value="#2E7D32"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Izin">
                                        <Setter Property="Foreground" Value="#1565C0"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Sakit">
                                        <Setter Property="Foreground" Value="#EF6C00"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Alpha">
                                        <Setter Property="Foreground" Value="#C62828"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Keterangan" Binding="{Binding Keterangan}" Width="1.4*"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Ringkasan / counter -->
            <Border Grid.Row="2" Margin="0,10,0,0" Padding="12,8"
                    Background="#F0F4F8" CornerRadius="4">
                <TextBlock x:Name="txtSummary" FontWeight="SemiBold" Text="Total: 0 data"/>
            </Border>
        </Grid>
    </Grid>
</Window>
